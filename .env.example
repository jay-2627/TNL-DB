# Supabase/Postgres connection string.
# Use the Supabase pooled connection string for serverless deployments.
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Long random string, at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Initial founder password used only by the seed script.
FOUNDER_PASSWORD=change-this-before-production

# Optional: the public base URL of the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
